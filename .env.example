# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# LLM (for pre-filter and scoring)
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=step-3.7-flash

# API Auth (for POST endpoints)
API_KEY=your_api_key_for_write_endpoints

# Vercel
VERCEL_TOKEN=your_vercel_token

# Public API rate limiting (optional; falls back to in-memory when unset)
# Create a free database at https://upstash.com and copy the REST credentials
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token
# Override the per-IP limit (default 60 req/min, min 10, max 600)
# PUBLIC_API_RATE_LIMIT=60

# Site
NEXT_PUBLIC_SITE_URL=https://factoring-hot.你的域名.com
NEXT_PUBLIC_SITE_NAME=保理 HOT
